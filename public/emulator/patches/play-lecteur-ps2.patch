--- a/Source/gs/GSHandler.cpp
+++ b/Source/gs/GSHandler.cpp
@@ -414,8 +414,12 @@ void CGSHandler::ResetVBlank()
 {
 	std::lock_guard registerMutexLock(m_registerMutex);
 
-	//Alternate current field
-	m_nCSR ^= CSR_FIELD;
+	//Alternate current field. Skipping this ("field stabilization") keeps a constant field
+	//so interlaced games stop bobbing the image vertically by one line (anti-tremblement).
+	if(!m_stabilizeField)
+	{
+		m_nCSR ^= CSR_FIELD;
+	}
 }
 
