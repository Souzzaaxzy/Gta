+int getDrawCalls()
+{
+	return CStatsManager::GetInstance().GetDrawCalls();
+}
+
+//Instrumentation : % d'occupation du coeur EE (EE+VU). ~100% => on est CPU-bound.
+float getEeUsage()
+{
+	auto info = CStatsManager::GetInstance().GetCpuUtilisationInfo();
+	return CStatsManager::ComputeCpuUsageRatio(info.eeIdleTicks, info.eeTotalTicks);
+}
+
+//Instrumentation : % d'occupation du coeur IOP.
+float getIopUsage()
+{
+	auto info = CStatsManager::GetInstance().GetCpuUtilisationInfo();
+	return CStatsManager::ComputeCpuUsageRatio(info.iopIdleTicks, info.iopTotalTicks);
+}
+
 void clearStats()
 {
 	CStatsManager::GetInstance().ClearStats();
 }
 
+//---- Sauvegardes d'état (save states) --------------------------------------
+//Le JS pilote le chemin dans MEMFS : pour sauvegarder il appelle saveState(path)
+//puis lit les octets via Module.FS ; pour charger il écrit d'abord le fichier
+//via Module.FS puis appelle loadState(path).
+bool saveState(std::string path)
+{
+	if(!g_virtualMachine) return false;
+	try { return g_virtualMachine->SaveState(path).get(); }
+	catch(...) { return false; }
+}
+
+bool loadState(std::string path)
+{
+	if(!g_virtualMachine) return false;
+	try { return g_virtualMachine->LoadState(path).get(); }
+	catch(...) { return false; }
+}
+
+//---- Réglages (à appeler AVANT initVm pour la résolution) ------------------
+//Facteur de résolution interne du renderer OpenGL (1 = natif ; 2 = 2x, plus net
+//mais plus lourd). Le renderer ne descend pas sous le natif.
+void setResolutionFactor(int factor)
+{
+	if(factor < 1) factor = 1;
+	CAppConfig::GetInstance().SetPreferenceInteger(PREF_CGSH_OPENGL_RESOLUTION_FACTOR, factor);
+}
+
+//Limiteur de framerate (true = calé sur la fréquence de rafraîchissement).
+void setFrameLimiter(bool enabled)
+{
+	CAppConfig::GetInstance().SetPreferenceBoolean(PREF_PS2_LIMIT_FRAMERATE, enabled);
+}
+
+//Anti-tremblement (expérimental) : fige le champ d'entrelacement pour supprimer le
+//bob vertical d'1 ligne des jeux entrelacés. Réglable à chaud (après initVm).
+void setDeinterlace(bool enabled)
+{
+	if(g_virtualMachine && g_virtualMachine->GetGSHandler())
+	{
+		g_virtualMachine->GetGSHandler()->SetFieldStabilization(enabled);
+	}
+}
